{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperDM",
  "version": "0.1.0",
  "identifier": "com.hyperdm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperDM — High-Speed Download Manager",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
