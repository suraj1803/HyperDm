{
  "manifest_version": 3,
  "name": "HyperDM Integration",
  "version": "1.0.1",
  "description": "Automatically intercept browser downloads and accelerate them with HyperDM's dynamic file segmentation engine.",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HyperDM Integration",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hyperdm-integration@hyperdm.local",
      "strict_min_version": "109.0"
    }
  }
}
